<link webc:scoped rel="stylesheet" href="/css/modal.css">
<script webc:type="js">
if (!label) {throw new Error('modal-dialog component is missing required prop label');};
``
</script>
<div class="modal-trigger-button-wrapper">
<button :commandFor="uid" command="show-modal" aria-haspopup="dialog" @text="label"></button>
</div>
<dialog :id="uid" :aria-labelledby="uid + '-heading'">
<div class="dialog-header-wrapper">
<h1 tabindex="-1" autofocus :id="uid + '-heading'" @text="if (heading) heading; else label"></h1>
</div>
<section aria-label="dialog scrollable" tabindex="0" class="dialog-main-wrapper">
<slot></slot>
</section>
<div class="dialog-footer-wrapper">
<button type="button" :commandFor="uid" command="close" type="button">Close</button>
</div>
</dialog>